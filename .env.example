# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Time zone used for "today", "overdue" and follow-up shortcuts
NEXT_PUBLIC_APP_TIMEZONE=America/New_York

# Server only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# Review publisher terms and applicable permissions before enabling requests.
DISCOVERY_NEFBA_DIRECTORY_ALLOWED=false
DISCOVERY_NEFBA_PINNACLE_ALLOWED=false
DISCOVERY_RADIUS_MILES=75
# Optional comma-separated authorized HTTPS JSON feed URLs (up to two).
DISCOVERY_AUTHORIZED_FEEDS=
